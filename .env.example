# Process environment for a production host. Do not commit real values.
SPRING_PROFILES_ACTIVE=prod
# Render injects PORT automatically. Set SERVER_PORT only for local/prod jars.
SERVER_PORT=8080

# Aiven MySQL example (TLS required). Replace host, port, and database name.
DB_URL=jdbc:mysql://YOUR_SERVICE.aivencloud.com:YOUR_PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=
# Keep low on free tiers (Aiven free max_connections is 76).
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# At least 32 characters. Do not reuse the development or test default.
JWT_SECRET=
JWT_ACCESS_TTL=PT8H

# Comma-separated browser origins. Wildcards are rejected in production.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Leave false on a public host. Set true only on a private network.
API_DOCS_ENABLED=false
LOGIN_MAX_ATTEMPTS=20
LOGIN_WINDOW=PT1M
REVOKED_TOKEN_CLEANUP_MS=3600000

# Frontend (Vercel project Environment Variable). Build-time only.
# Use the Render service origin, with or without /api/v1.
# API_URL=https://aveline-bizflow-api.onrender.com
